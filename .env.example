# Test day: set these two, nothing else needs to change.
RPC_URL=https://api.mainnet-beta.solana.com
CHAIN_ID=

# Strategies (arb is read-only until LIVE=1)
LIVE=0
ENABLE_ARB=1
ENABLE_SANDWICH=0
ENABLE_JIT_LIQUIDITY=0

# Sizing / thresholds
TRADE_LAMPORTS=250000000
MIN_NET_LAMPORTS=10000
PRIORITY_FEE_LAMPORTS=20000

# Simulation (backtest.mjs, scan.mjs, sweep.mjs) only READS the chain and is safe on mainnet.
# Live sandwiching is the only thing guarded: it needs ENABLE_SANDWICH=1, a CHAIN_ID, and a non-public-mainnet RPC.
